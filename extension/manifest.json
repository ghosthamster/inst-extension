{
  "manifest_version": 3,
  "name": "Inst · Quick Share",
  "version": "1.1.0",
  "description": "Share Instagram reels and posts to saved contacts with shortcuts, a quick picker, and optional messages.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inst · Quick Share",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "core.js",
        "chooser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "share-to-favourite": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Immediately send the current reel/post to your favourite"
    },
    "pick-contact": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Choose a saved contact and share"
    },
    "share-with-message": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Add a message before sharing"
    },
    "share-contact-1": {
      "description": "Immediately share to contact slot 1"
    },
    "share-contact-2": {
      "description": "Immediately share to contact slot 2"
    },
    "share-contact-3": {
      "description": "Immediately share to contact slot 3"
    },
    "share-contact-4": {
      "description": "Immediately share to contact slot 4"
    },
    "share-contact-5": {
      "description": "Immediately share to contact slot 5"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
